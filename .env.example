# ─── Firebase (Client SDK) ──────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase (Admin SDK — server-only) ─────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Printify ────────────────────────────────────────────────────────────────
PRINTIFY_ACCESS_TOKEN=your_printify_personal_access_token
PRINTIFY_SHOP_ID=your_printify_shop_id
PRINTIFY_WEBHOOK_SECRET=your_printify_webhook_secret

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Razorpay (Client SDK) ───────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ─── Site URL (for OG images / metadataBase) ─────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://gerkink.shop

# ─── Email SMTP Settings (Google SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password

# ─── Encryption Key (for bank details at rest) ────────────────────────────────
# Use a strong random string. Once set, DO NOT change without re-encrypting data.
ENCRYPTION_KEY=your_strong_random_encryption_key

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── PayPal ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox

# ─── Wire Transfer Display (public defaults for prebook page) ────────────────
# Shown to customers paying by wire. Real values live here or in Firestore settings/bank_details.
WIRE_BANK_NAME=
WIRE_ACCOUNT_HOLDER=

